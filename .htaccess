Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── Force HTTPS ────────────────────────────────────────────────────────────
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ── Block direct access to source code and sensitive files ─────────────────
    RewriteRule ^(backend/(?!public/)|frontend/|\.git/|deploy\.sh) - [F,L]

    # ── Route /api/* → Laravel backend ────────────────────────────────────────
    RewriteRule ^api(/.*)?$ backend/public/index.php [QSA,L]

    # ── Serve real files directly (JS, CSS, images in public-html/) ───────────
    # Vite builds with base=/public-html/ so assets are at /public-html/assets/*
    # Apache serves ~/public_html/public-html/assets/* directly — no rewrite needed
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ── All other routes → React SPA ──────────────────────────────────────────
    RewriteRule ^ public-html/index.html [L]
</IfModule>

# ─── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── Gzip Compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ─── Browser caching for static assets ───────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
